# macOS
.DS_Store

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
build/

# Generated project (regenerate with `xcodegen generate`)
FWBSocial.xcodeproj/

# iCloud Drive conflict copies. These are generated by iCloud syncing the
# working directory and they BREAK builds: XcodeGen and xcodebuild both pick up
# a stray "Info 2.plist" or "FWBSocial 2.xcodeproj" as if it were real.
*\ 2.*
*\ 2
# iCloud numbers its later conflict copies too — " 3", " 4" and up. The
# original pattern only caught the first one, and a run that regenerated the
# project while iCloud was mid-sync committed two of them.
*\ [0-9].*
*\ [0-9]
