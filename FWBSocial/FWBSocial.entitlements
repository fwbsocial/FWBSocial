<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple — Guideline 4.8, ships day one (PLAN.md §3.1, §6.1).
	     The App ID `events.fwb.social` under team NVT8G575R7 needs the
	     "Sign in with Apple" capability enabled in the Developer portal, or a
	     device/distribution build fails to sign. Simulator builds do not check. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Declared Age Range — commissioner decision Q16: the 18+ gate is the
	     system Declared Age Range API, not a self-declared birthdate.
	     Portal capability: "Declared Age Range" (BOOLEAN, no distribution
	     approval required). Without it, `AgeRangeService` throws
	     `.notAvailable` at runtime on device. -->
	<key>com.apple.developer.declared-age-range</key>
	<true/>

	<!-- APNs. Resolved from the `APS_ENVIRONMENT` build setting: `development`
	     for Debug (devicectl installs), `production` for Release — see
	     project.yml. A release build that claims `development` gets a token
	     APNs will not deliver to, and the failure is silent.
	     Requires the Push Notifications capability on the App ID. -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>

	<!-- App Group — shared with FWBSocialNotificationService (PLAN.md §4.3.5).
	     The NSE resolves sender names, conversation titles, avatars and the
	     `hide_message_previews` flag from here, ON DEVICE, because the APNs
	     payload carries metadata only: the server cannot read the message and
	     therefore cannot put a preview in the push.
	     Portal capability: App Groups → group.events.fwb.social. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.events.fwb.social</string>
	</array>

	<!-- Keychain Sharing — the NSE's decrypt path reads this device's X-Wing
	     private key and the bearer token out of the keychain, and an extension
	     has its OWN default access group. House gotcha
	     (`reference_commune_nse_keychain_no_migration`): items do NOT migrate
	     into a shared group. They must be WRITTEN with this group set, which is
	     what `ChatKeychain` and `KeychainHelper` do.
	     Portal capability: Keychain Sharing → events.fwb.social. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)events.fwb.social</string>
	</array>
</dict>
</plist>
